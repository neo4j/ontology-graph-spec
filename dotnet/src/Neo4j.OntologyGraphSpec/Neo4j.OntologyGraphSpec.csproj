<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Neo4j.OntologyGraphSpec</PackageId>
    <Authors>Neo4j</Authors>
    <Description>Typed ontology graph documents, JSON/YAML codecs, validation and migration backed by the shared Kotlin core.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neo4j/ontology-graph-spec</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://neo4j.com/docs/ontology-graph-spec/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <NativeAssetsDirectory Condition="'$(NativeAssetsDirectory)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native</NativeAssetsDirectory>
    <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Neo4j.OntologyGraphSpec.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(NativeAssetsDirectory)/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Update="$(NativeAssetsDirectory)/$(NativeRuntimeIdentifier)/native/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeAssetsForPack" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_NativeAsset Include="$(NativeAssetsDirectory)/**/*.dll;$(NativeAssetsDirectory)/**/*.so;$(NativeAssetsDirectory)/**/*.dylib" />
    </ItemGroup>
    <Error Condition="'@(_NativeAsset)' == ''" Text="Build and stage native assets with dotnet/scripts/build-native.ps1 before packing." />
    <ItemGroup Condition="'$(RequireAllNativeAssets)' == 'true'">
      <_RequiredNativeAsset Include="$(NativeAssetsDirectory)/win-x64/native/graphdatamodel.dll;$(NativeAssetsDirectory)/linux-x64/native/libgraphdatamodel.so;$(NativeAssetsDirectory)/linux-arm64/native/libgraphdatamodel.so;$(NativeAssetsDirectory)/osx-arm64/native/libgraphdatamodel.dylib" />
    </ItemGroup>
    <Error Condition="'$(RequireAllNativeAssets)' == 'true' And !Exists('%(_RequiredNativeAsset.Identity)')" Text="Release package is missing %(_RequiredNativeAsset.Identity)." />
  </Target>
</Project>
