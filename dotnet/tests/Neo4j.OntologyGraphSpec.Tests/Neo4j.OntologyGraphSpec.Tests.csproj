<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Test.props" />
  <PropertyGroup>
    <!-- Compile generated XML documentation too, so malformed schema descriptions cannot break consumers. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Neo4j.OntologyGraphSpec/Neo4j.OntologyGraphSpec.csproj" />
    <Compile Include="../../../tools/schema-generator/internal/generator/testdata/expected/*.cs.expected" Link="Generated/%(Filename).cs" />
  </ItemGroup>
</Project>
