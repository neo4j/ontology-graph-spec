{
    "schema": "https://neo4j.com/docs/ontology-graph-spec/1.1.0/schema.json",
    "version": "1",
    "id": "patient-journey",
    "name": "Patient Journey",
    "description": "Models a patient's history as a connected clinical record: encounters in sequence, and the observations taken, conditions diagnosed and drugs prescribed at each one, together with the providers and organisations that delivered the care. Answers what one patient's pathway looked like over time, and which conditions and treatments recur together across a population.",
    "nodes": {
        "Patient": {
            "labels": {
                "identifier": "Patient"
            },
            "properties": {
                "id": {
                    "type": "STRING",
                    "description": "Stable identifier for the patient in the source system, expected to be opaque rather than derived from any identifying detail. e.g. `fd65a941-3fa1-337f-28e2-6c9d3922c1af`."
                },
                "name": {
                    "type": "STRING",
                    "description": "Display name of the patient as held by the source system. Not an identifier — distinct patients may share a name, so it is expected never to be used for matching. e.g. `Gerardo Covarrubias`."
                },
                "birthDate": {
                    "type": "ZONED DATETIME",
                    "description": "Date of birth, as an ISO 8601 zoned datetime. Only the calendar date carries meaning; the time and zone are an artefact of importing a date into a temporal type and should not be read as a time of birth. e.g. `1951-09-13T00:00:00Z`."
                }
            },
            "constraints": {
                "key_Patient_id": {
                    "type": "KEY",
                    "properties": [
                        "id"
                    ],
                    "name": "id_Patient_key"
                },
                "exists_Patient_name": {
                    "type": "EXISTS",
                    "properties": [
                        "name"
                    ],
                    "name": "name_Patient_exists"
                },
                "exists_Patient_birthDate": {
                    "type": "EXISTS",
                    "properties": [
                        "birthDate"
                    ],
                    "name": "birthDate_Patient_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": -150.0,
                    "y": 0.0
                }
            },
            "description": "A person receiving care, and the anchor of a longitudinal record. Every clinical fact in the reference ontology reaches a patient through an encounter rather than attaching to the patient directly, so that when something was recorded is never lost.",
            "aliases": [
                "Person"
            ]
        },
        "Encounter": {
            "labels": {
                "identifier": "Encounter"
            },
            "properties": {
                "id": {
                    "type": "STRING",
                    "description": "Stable identifier for the encounter in the source system. e.g. `512815bc-0b5c-bac3-ec59-9eb9fc945312`."
                },
                "date": {
                    "type": "ZONED DATETIME",
                    "description": "Date the encounter took place, as an ISO 8601 zoned datetime. Only the calendar date carries meaning; the time and zone are an artefact of importing a date into a temporal type. Ordering on this is what reconstructs a pathway. e.g. `2005-05-26T00:00:00Z`."
                },
                "type": {
                    "type": "STRING",
                    "description": "Class of encounter, as a lower-case keyword from the source system's own small vocabulary rather than a coded terminology value. e.g. `wellness`."
                }
            },
            "constraints": {
                "key_Encounter_id": {
                    "type": "KEY",
                    "properties": [
                        "id"
                    ],
                    "name": "id_Encounter_key"
                },
                "exists_Encounter_date": {
                    "type": "EXISTS",
                    "properties": [
                        "date"
                    ],
                    "name": "date_Encounter_exists"
                },
                "exists_Encounter_type": {
                    "type": "EXISTS",
                    "properties": [
                        "type"
                    ],
                    "name": "type_Encounter_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": 0.0,
                    "y": 0.0
                }
            },
            "description": "A single episode of care — one visit, admission or consultation. The pivot of the whole reference ontology: observations, diagnoses, prescriptions and the attending provider all hang off the encounter, which is what gives every clinical fact a date and a context.",
            "aliases": [
                "Visit"
            ]
        },
        "Observation": {
            "labels": {
                "identifier": "Observation"
            },
            "properties": {
                "id": {
                    "type": "STRING",
                    "description": "Stable identifier for this individual result. e.g. `obs-512815bc-001`."
                },
                "code": {
                    "type": "STRING",
                    "description": "Code for what was measured, from a standard observation terminology (LOINC in the bundled example). Expected to be the code system's own notation, unchanged. e.g. `8480-6`."
                },
                "description": {
                    "type": "STRING",
                    "description": "Human-readable name of what was measured, corresponding to `code`. Carried alongside the code so results are legible without a terminology lookup. e.g. `Systolic Blood Pressure`."
                },
                "value": {
                    "type": "STRING",
                    "description": "The measured result, held as text so that numeric, coded and free-text results can share one property. Numeric comparisons therefore require an explicit cast; the property is expected to carry no unit, which lives in `units`. e.g. `148`."
                },
                "units": {
                    "type": "STRING",
                    "description": "Unit of `value`, in UCUM notation. Expected to be absent or meaningless for non-numeric results. e.g. `mm[Hg]`."
                }
            },
            "constraints": {
                "key_Observation_id": {
                    "type": "KEY",
                    "properties": [
                        "id"
                    ],
                    "name": "id_Observation_key"
                },
                "exists_Observation_code": {
                    "type": "EXISTS",
                    "properties": [
                        "code"
                    ],
                    "name": "code_Observation_exists"
                },
                "exists_Observation_description": {
                    "type": "EXISTS",
                    "properties": [
                        "description"
                    ],
                    "name": "description_Observation_exists"
                },
                "exists_Observation_value": {
                    "type": "EXISTS",
                    "properties": [
                        "value"
                    ],
                    "name": "value_Observation_exists"
                },
                "exists_Observation_units": {
                    "type": "EXISTS",
                    "properties": [
                        "units"
                    ],
                    "name": "units_Observation_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": 100.0,
                    "y": -100.0
                }
            },
            "description": "A single measurement or test result recorded at an encounter — a vital sign or a lab value. Each observation belongs to exactly one encounter and is never shared between patients, which is what distinguishes it from a condition or a drug."
        },
        "Condition": {
            "labels": {
                "identifier": "Condition"
            },
            "properties": {
                "code": {
                    "type": "STRING",
                    "description": "The condition's identifier in a standardised clinical terminology (SNOMED CT in the bundled example), and the key on which patients' diagnoses converge. e.g. `59621000`."
                },
                "description": {
                    "type": "STRING",
                    "description": "Human-readable name of the condition, corresponding to `code`. e.g. `Hypertension`."
                }
            },
            "constraints": {
                "key_Condition_code": {
                    "type": "KEY",
                    "properties": [
                        "code"
                    ],
                    "name": "code_Condition_key"
                },
                "exists_Condition_description": {
                    "type": "EXISTS",
                    "properties": [
                        "description"
                    ],
                    "name": "description_Condition_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": 125.0,
                    "y": 0.0
                }
            },
            "description": "A clinical condition, shared across the whole population rather than owned by a patient. One node per standardised code, so that every patient diagnosed with it connects to the same node — which is precisely what makes cross-patient comorbidity analysis a traversal. If source data carries local codes instead, these nodes will not merge and population queries silently mislead.",
            "aliases": [
                "Diagnosis"
            ]
        },
        "Drug": {
            "labels": {
                "identifier": "Drug"
            },
            "properties": {
                "code": {
                    "type": "STRING",
                    "description": "The drug's identifier in a standardised medication terminology (RxNorm in the bundled example), and the key on which patients' prescriptions converge. e.g. `309362`."
                },
                "name": {
                    "type": "STRING",
                    "description": "Human-readable name of the medication, corresponding to `code` and conventionally including strength and form. e.g. `Clopidogrel 75 MG Oral Tablet`."
                }
            },
            "constraints": {
                "key_Drug_code": {
                    "type": "KEY",
                    "properties": [
                        "code"
                    ],
                    "name": "code_Drug_key"
                },
                "exists_Drug_name": {
                    "type": "EXISTS",
                    "properties": [
                        "name"
                    ],
                    "name": "name_Drug_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": 100.0,
                    "y": 100.0
                }
            },
            "description": "A medication, shared across the whole population rather than owned by a patient. One node per standardised code, so that co-prescription and treatment-pattern analysis across patients becomes a traversal. The same caution about local codes applies as for conditions.",
            "aliases": [
                "Medication"
            ]
        },
        "Provider": {
            "labels": {
                "identifier": "Provider"
            },
            "properties": {
                "id": {
                    "type": "STRING",
                    "description": "Stable identifier for the provider in the source system. e.g. `6e73bd55-65e7-325b-a8c1-e4f8547461b3`."
                },
                "name": {
                    "type": "STRING",
                    "description": "Display name of the provider. Not an identifier. e.g. `Sondra Botsford`."
                }
            },
            "constraints": {
                "key_Provider_id": {
                    "type": "KEY",
                    "properties": [
                        "id"
                    ],
                    "name": "id_Provider_key"
                },
                "exists_Provider_name": {
                    "type": "EXISTS",
                    "properties": [
                        "name"
                    ],
                    "name": "name_Provider_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": 0.0,
                    "y": 133.0
                }
            },
            "description": "A clinician who delivers care at encounters. Held as an entity so that workload and referral patterns can be measured across encounters and patients.",
            "aliases": [
                "Healthcare professional"
            ]
        },
        "Speciality": {
            "labels": {
                "identifier": "Speciality"
            },
            "properties": {
                "name": {
                    "type": "STRING",
                    "description": "Name of the speciality as the source system records it, and the key on which providers converge. e.g. `General Practice`."
                }
            },
            "constraints": {
                "key_Speciality_name": {
                    "type": "KEY",
                    "properties": [
                        "name"
                    ],
                    "name": "name_Speciality_key"
                }
            },
            "extensions": {
                "display": {
                    "x": 100.0,
                    "y": 200.0
                }
            },
            "description": "A field of clinical practice, shared by every provider who works in it. Keyed on the speciality's name rather than on a code, so providers converge only when the source system spells the speciality identically."
        },
        "Organisation": {
            "labels": {
                "identifier": "Organisation"
            },
            "properties": {
                "id": {
                    "type": "STRING",
                    "description": "Stable identifier for the organisation in the source system. e.g. `be4c63f3-8d38-3fa9-a183-62045b5c85f6`."
                },
                "name": {
                    "type": "STRING",
                    "description": "Name of the organisation as published. e.g. `VA Boston Healthcare System`."
                },
                "address": {
                    "type": "STRING",
                    "description": "Postal address of the organisation as a single unparsed line, with no separate town, region or postcode fields and no geocoding. e.g. `150 South Huntington Avenue Jamaica Plain MA`."
                }
            },
            "constraints": {
                "key_Organisation_id": {
                    "type": "KEY",
                    "properties": [
                        "id"
                    ],
                    "name": "id_Organisation_key"
                },
                "exists_Organisation_name": {
                    "type": "EXISTS",
                    "properties": [
                        "name"
                    ],
                    "name": "name_Organisation_exists"
                }
            },
            "extensions": {
                "display": {
                    "x": -100.0,
                    "y": 200.0
                }
            },
            "description": "A healthcare facility or provider organisation that clinicians belong to — the institutional level above the individual provider.",
            "aliases": [
                "Healthcare institution",
                "Facility"
            ]
        }
    },
    "relationships": {
        "hasEncounter": {
            "type": "HAS_ENCOUNTER",
            "from": {
                "node": "Patient"
            },
            "to": {
                "node": "Encounter",
                "count": 1
            },
            "description": "Attaches an episode of care to the patient who received it. Exactly one patient per encounter; a patient may have many encounters, or none. Every clinical fact in the reference ontology reaches its patient along this link."
        },
        "next": {
            "type": "NEXT",
            "from": {
                "node": "Encounter",
                "max_count": 1
            },
            "to": {
                "node": "Encounter",
                "max_count": 1
            },
            "description": "Chains an encounter to the one that followed it for the same patient, in date order — the explicit sequence that makes a care pathway walkable without sorting. At most one following encounter and at most one preceding encounter, so the chain is a simple line per patient and never branches. Not every encounter is chained, so the absence of this link does not mean an encounter was the patient's last; traversals along it are expected to be bounded by an explicit maximum depth."
        },
        "hasObservation": {
            "type": "HAS_OBSERVATION",
            "from": {
                "node": "Encounter"
            },
            "to": {
                "node": "Observation",
                "count": 1
            },
            "description": "Records that this measurement was taken at this encounter. Exactly one encounter per observation; an encounter may carry several observations, or none."
        },
        "diagnosed": {
            "type": "DIAGNOSED",
            "from": {
                "node": "Encounter"
            },
            "to": {
                "node": "Condition"
            },
            "description": "Records that this condition was diagnosed at this encounter. An encounter may diagnose several conditions, or none; a condition, being shared across the population, is diagnosed at many encounters. Two patients meet at the condition node, which is what comorbidity analysis traverses."
        },
        "prescribed": {
            "type": "PRESCRIBED",
            "from": {
                "node": "Encounter"
            },
            "to": {
                "node": "Drug"
            },
            "description": "Records that this medication was prescribed at this encounter. An encounter may prescribe several drugs, or none; a drug, being shared across the population, is prescribed at many encounters. Repeated pairs of drugs reached this way are what co-prescription analysis counts."
        },
        "attendedBy": {
            "type": "ATTENDED_BY",
            "from": {
                "node": "Encounter",
                "count": 1
            },
            "to": {
                "node": "Provider"
            },
            "description": "Records the clinician who delivered this encounter. Exactly one attending provider per encounter; a provider attends many encounters, or none. Counting along this link gives provider workload."
        },
        "hasSpeciality": {
            "type": "HAS_SPECIALITY",
            "from": {
                "node": "Provider",
                "count": 1
            },
            "to": {
                "node": "Speciality"
            },
            "description": "Places a provider in their field of practice. Exactly one speciality per provider; a speciality is shared by many providers, or by none. The reference ontology records a provider's current speciality only, not a history of it."
        },
        "belongsTo": {
            "type": "BELONGS_TO",
            "from": {
                "node": "Provider",
                "count": 1
            },
            "to": {
                "node": "Organisation"
            },
            "description": "Places a provider within the organisation they practise at. Exactly one organisation per provider, so a clinician working across several sites cannot be represented without extending the reference ontology; an organisation may have many providers, or none."
        }
    },
    "extensions": {
