{
  "schema": "https://neo4j.com/docs/ontology-graph-spec/1.1.0/schema.json",
  "version": "1",
  "id": "properties",
  "description": "Missing, whitespace-only and duplicate property names, including a name shared by three properties.",
  "nodes": {
    "person": {
      "properties": {
        "id": { "type": "STRING" },
        "name": { "type": "STRING", "name": "name" },
        "fullName": { "type": "STRING", "name": "name" },
        "nickName": { "type": "STRING", "name": "name" },
        "blank": { "type": "STRING", "name": "  " }
      }
    }
  },
  "relationships": {
    "knows": {
      "type": "KNOWS",
      "from": {},
      "to": {},
      "properties": {
        "note": { "type": "STRING" },
        "since": { "type": "DATE", "name": "since" },
        "from": { "type": "DATE", "name": "since" }
      }
    }
  }
}
