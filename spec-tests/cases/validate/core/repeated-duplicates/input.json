{
  "schema": "https://neo4j.com/docs/ontology-graph-spec/1.1.0/schema.json",
  "version": "1",
  "id": "repeated-duplicates",
  "description": "Values repeated three times: every repeat after the first is reported.",
  "nodes": {
    "person": {
      "labels": {
        "identifier": "Person",
        "implied": [
          "Agent",
          "Agent",
          "Agent"
        ]
      },
      "aliases": [
        "Human",
        "Human",
        "Human"
      ],
      "properties": {
        "name": {
          "type": "STRING",
          "aliases": [
            "fullName",
            "fullName",
            "fullName"
          ]
        }
      },
      "constraints": {
        "name_unique": {
          "type": "UNIQUE",
          "properties": [
            "name",
            "name",
            "name"
          ]
        }
      },
      "extensions": {
        "indexes": {
          "name_range": {
            "type": "RANGE",
            "labels": [
              "Person",
              "Person",
              "Person"
            ],
            "properties": [
              "name",
              "name",
              "name"
            ]
          }
        }
      }
    }
  },
  "relationships": {
    "knows": {
      "type": "KNOWS",
      "from": {},
      "to": {},
      "aliases": [
        "FRIEND_OF",
        "FRIEND_OF",
        "FRIEND_OF"
      ]
    }
  },
  "extensions": {
    "data_source_tables": {
      "people": {
        "source": "local",
        "columns": [
          {
            "name": "id",
            "supported": [
              "STRING",
              "STRING",
              "STRING"
            ]
          }
        ]
      }
    }
  }
}
