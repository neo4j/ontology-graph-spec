{
  "schema": "https://neo4j.com/docs/ontology-graph-spec/1.1.0/schema.json",
  "version": "1",
  "id": "every-set",
  "description": "An issue from every validation set.",
  "nodes": {
    "person": {
      "labels": { "identifier": "Person:Human" },
      "aliases": ["Human", "Human"],
      "properties": { "id": { "type": "STRING" } }
