          "type": "INTEGER"
        },
        "date": {
          "type": "DATE"
        },
        "amount": {
          "type": "FLOAT"
        }
      }
    }
  },
  "extensions": {
    "mappings": {
      "mapping0": [
        {
          "type": "NODE",
          "node": "Account",
          "table": "accounts",
          "properties": {
