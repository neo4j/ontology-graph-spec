            }
          ],
          "to_node": [
            {
              "node_key_column": "id",
              "relationship_column": "to_id"
            }
          ],
          "properties": {
            "tx_id": {
              "column": "id"
            },
            "date": {
              "column": "created_at"
            },
            "amount": {
              "column": "amount"
            }
          },
          "key_columns": [
            "id"
          ]
        }
      ]
    }
  }
